<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wodefinitions>
    <wo class="ViewLink" wocomponentcontent="true">
    <binding name="object"/>
        <validation message="'object' is a required binding.">
            <unbound name="object"/>
        </validation>
    <binding name="disabled"/>
    <binding name="class"/>
    <binding name="id"/>
    <binding name="style"/>
    <binding name="target"/>
    <binding name="title"/>
    <binding name="accesskey"/>
    <binding name="data-toggle"/>
    </wo>
</wodefinitions>
